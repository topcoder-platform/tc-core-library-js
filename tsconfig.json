{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"], "strict": true, "esModuleInterop": true,
    "declaration": true, "sourceMap": true, "outDir": "dist", "rootDir": "src",
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
