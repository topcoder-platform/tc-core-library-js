{
  "name": "tc-core-library-js",
  "version": "4.0.0-rc.1",
  "description": "Shared Topcoder JWT verification, machine authentication and Bus API publishing",
  "license": "ISC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint": "eslint src test",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.cjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "@types/jsonwebtoken": "^9.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "bluebird": "^3.7.2",
    "eslint": "^10.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topcoder-platform/tc-core-library-js.git"
  }
}
